<?xml version="1.0" encoding="utf-8" ?>

<!-- Page MAUI pour gérer les auteurs -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiblioKowazoMaui.Views.AuteursPage"
             Title="Auteurs">

    <!-- Permet de scroller si le contenu est grand -->
    <ScrollView>

        <!-- Conteneur vertical principal -->
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Titre de la page -->
            <Label Text="Gestion des Auteurs"
                   FontSize="22"
                   FontAttributes="Bold" />

            <!-- Zone de saisie (formulaire) -->
            <Frame Padding="12"
                   BorderColor="#CCCCCC"
                   CornerRadius="8">

                <VerticalStackLayout Spacing="8">

                    <!-- Champ Nom -->
                    <Label Text="Nom :" FontSize="14" />
                    <Entry x:Name="TxtNom"
                           Placeholder="Entrez le nom" />

                    <!-- Champ Prénom -->
                    <Label Text="Prénom :" FontSize="14" />
                    <Entry x:Name="TxtPrenom"
                           Placeholder="Entrez le prénom" />

                    <!-- Boutons d'action -->
                    <HorizontalStackLayout Spacing="8">

                        <!-- Ajouter un auteur -->
                        <Button Text="Ajouter"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                Clicked="BtnAjouter_Click" />

                        <!-- Modifier un auteur -->
                        <Button Text="Modifier"
                                BackgroundColor="#f5a623"
                                TextColor="White"
                                Clicked="BtnModifier_Click" />

                        <!-- Supprimer un auteur -->
                        <Button Text="Supprimer"
                                BackgroundColor="#ff5252"
                                TextColor="White"
                                Clicked="BtnSupprimer_Click" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Message de statut (ex: succès ou erreur) -->
            <Label x:Name="LblStatus"
                   TextColor="Gray"
                   FontSize="12" />

            <!-- Liste des auteurs -->
            <CollectionView x:Name="cvAuteurs"
                            SelectionMode="Single"
                            SelectionChanged="CvAuteurs_SelectionChanged"
                            EmptyView="Aucun auteur trouvé.">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <!-- Carte pour chaque auteur -->
                        <Frame Margin="0,2"
                               Padding="12"
                               CornerRadius="8"
                               BorderColor="#CCCCCC">

                            <HorizontalStackLayout Spacing="12">

                                <!-- Avatar / initial -->
                                <Border StrokeShape="Ellipse"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        BackgroundColor="LightBlue">

                                    <!-- Nom affiché dans le cercle -->
                                    <Label Text="{Binding Nom}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold" />
                                </Border>

                                <!-- Infos auteur -->
                                <VerticalStackLayout VerticalOptions="Center">

                                    <!-- Nom -->
                                    <Label Text="{Binding Nom}"
                                           FontAttributes="Bold"
                                           FontSize="16" />

                                    <!-- Prénom -->
                                    <Label Text="{Binding Prenom}"
                                           TextColor="Gray"
                                           FontSize="13" />

                                </VerticalStackLayout>

                            </HorizontalStackLayout>
                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>